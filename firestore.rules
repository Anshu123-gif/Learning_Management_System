rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection: Users can read public profile or their own, and write their own profile
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || true; // Allow client creation during signup
    }
  }
}
