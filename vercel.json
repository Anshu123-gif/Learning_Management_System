{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/payments/:path*",
      "destination": "/api/payments?path=:path*"
    },
    {
      "source": "/api/videos/:path*",
      "destination": "/api/videos?path=:path*"
    },
    {
      "source": "/api/videos",
      "destination": "/api/videos"
    },
    {
      "source": "/api/courses/:path*",
      "destination": "/api/courses?path=:path*"
    },
    {
      "source": "/api/courses",
      "destination": "/api/courses"
    },
    {
      "source": "/api/quizzes/:quizId/submit",
      "destination": "/api/quizzes?quizId=:quizId&action=submit"
    },
    {
      "source": "/api/quizzes/:quizId/attempt",
      "destination": "/api/quizzes?quizId=:quizId&action=attempt"
    },
    {
      "source": "/api/quizzes/:path*",
      "destination": "/api/quizzes?path=:path*"
    },
    {
      "source": "/api/quizzes",
      "destination": "/api/quizzes"
    },
    {
      "source": "/api/health",
      "destination": "/api/auth?path=health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
